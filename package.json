{
  "name": "dataspecer-specification-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:normalize": "node --import tsx --test src/data/normalization/normalize-specification.test.ts",
    "test:loading": "node --import tsx --test src/data/loading/load-specification-from-url.test.ts",
    "test:semantic": "node --import tsx --test src/data/loading/load-semantic-specification.test.ts",
    "test:parsers": "node --import tsx --test src/data/semantic/vocabulary/parse-vocabulary.test.ts src/data/semantic/application-profile/parse-application-profile.test.ts",
    "test:explorer-model": "node --import tsx --test src/pages/spec-explorer/model/specification-explorer.test.ts",
    "test:primer-model": "node --import tsx --test src/pages/primer/model/primer.test.ts",
    "test:s2s-models": "node --import tsx --test src/pages/spec-to-spec/model/specification-overview.test.ts src/pages/spec-to-spec/model/specification-browser.test.ts",
    "test:data": "node --import tsx --test src/data/loading/load-specification-from-url.test.ts src/data/loading/load-semantic-specification.test.ts src/data/normalization/normalize-specification.test.ts src/data/semantic/vocabulary/parse-vocabulary.test.ts src/data/semantic/application-profile/parse-application-profile.test.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "n3": "^2.2.0",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/n3": "^1.26.1",
    "@types/node": "^22.15.29",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "prettier": "^3.9.4",
    "tsx": "^4.22.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.3.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  }
}
